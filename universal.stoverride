rules: #!replace
- GEOIP,LAN,DIRECT,no-resolve
- RULE-SET,001-Network-LAN-domain,Network-LAN
- DOMAIN-REGEX,^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$,Network-LAN
- RULE-SET,001-Network-LAN-ip0,Network-LAN,no-resolve
- RULE-SET,002-Protection-HTTPDNS-domain,Protection-HTTPDNS
- RULE-SET,002-Protection-HTTPDNS-ip0,Protection-HTTPDNS,no-resolve
- RULE-SET,003-Protection-Hijacking-domain,Protection-Hijacking
- DOMAIN-KEYWORD,gjfzpt,Protection-Hijacking,no-resolve
- DOMAIN-KEYWORD,chanct,Protection-Hijacking,no-resolve
- DOMAIN-KEYWORD,ifcert.cn,Protection-Hijacking,no-resolve
- DOMAIN-KEYWORD,fzlm,Protection-Hijacking,no-resolve
- DOMAIN-KEYWORD,fqzpt,Protection-Hijacking,no-resolve
- RULE-SET,003-Protection-Hijacking-ip0,Protection-Hijacking,no-resolve
- RULE-SET,004-REJECT-DROP-domain,REJECT-DROP
- DOMAIN-KEYWORD,app-analytics,REJECT-DROP
- DOMAIN-KEYWORD,analytics.,REJECT-DROP
- DOMAIN-KEYWORD,pclog.,REJECT-DROP
- DOMAIN-KEYWORD,applog.,REJECT-DROP
- DOMAIN-KEYWORD,ioslog.,REJECT-DROP
- DOMAIN-KEYWORD,pc-log.,REJECT-DROP
- DOMAIN-KEYWORD,app-log.,REJECT-DROP
- DOMAIN-KEYWORD,ios-log.,REJECT-DROP
- DOMAIN-KEYWORD,guide-acs.taobao.com,REJECT-DROP
- DOMAIN-KEYWORD,amdc.m.taobao.com,REJECT-DROP
- RULE-SET,005-Video-AppleTV-domain,Video-AppleTV
- RULE-SET,006-DNS-China-domain,DNS-China
- RULE-SET,007-DNS-Global-domain,DNS-Global
- RULE-SET,008-DNS-China-ip0,DNS-China,no-resolve
- RULE-SET,009-DNS-Global-ip0,DNS-Global,no-resolve
- AND,((NETWORK,udp),(DST-PORT,123),(NOT,((GEOIP,CN)))),NTP-Global
- AND,((NETWORK,udp),(DST-PORT,123),(GEOIP,CN)),NTP-China
- RULE-SET,010-ShortVideo-Kwai-domain,ShortVideo-Kwai
- RULE-SET,GeositeCN_Domain,Country-China
- DOMAIN-REGEX,^(?:[^.]+\.)*awsdns\-cn\-[^.][^.]\.biz$,Country-China
- DOMAIN-REGEX,^(?:[^.]+\.)*awsdns\-cn\-[^.][^.]\.com$,Country-China
- DOMAIN-REGEX,^(?:[^.]+\.)*awsdns\-cn\-[^.][^.]\.net$,Country-China
- DOMAIN-REGEX,^(?:[^.]+\.)*awsdns\-cn\-[^.][^.]\.top$,Country-China
- DOMAIN-REGEX,^(?:[^.]+\.)*[^.]*\-aweme\-[^.]*\.[^.]*\.[^.]*$,Country-China
- DOMAIN-REGEX,^(?:[^.]+\.)*[^.]*\-aweme\-[^.]*\.[^.]*\.[^.]*\.[^.]*$,Country-China
- DOMAIN-REGEX,^(?:[^.]+\.)*[^.]*\-aweme\-[^.]*\.[^.]*\.[^.]*\.[^.]*\.[^.]*$,Country-China
- RULE-SET,012-Country-China-domain,Country-China
- DOMAIN-REGEX,.+\.awsdns-cn-[0-9][0-9]\.(biz|com|net|top)$,Country-China
- DOMAIN-REGEX,.+\.awsdns-cn-[0-9][a-e0-9]\.cn$,Country-China
- RULE-SET,013-Speedtest-domain,Speedtest
- DOMAIN-REGEX,^speed\.(coe|open)\.ad\.[a-z]{2,6}\.prod\.hosts\.ooklaserver\.net$,Speedtest
- DOMAIN-KEYWORD,speedtest,Speedtest
- RULE-SET,014-NAS-Synology-domain,NAS-Synology
- DOMAIN-KEYWORD,synology,NAS-Synology
- RULE-SET,015-Home-Aqara-domain,Home-Aqara
- DOMAIN-KEYWORD,aqara-camera-usa.,Home-Aqara
- DOMAIN-KEYWORD,aqara-camera-ru.,Home-Aqara
- DOMAIN-KEYWORD,aqara-camera-kr.,Home-Aqara
- DOMAIN-KEYWORD,aqara-camera-ger.,Home-Aqara
- DOMAIN-KEYWORD,aqara-camera-au.,Home-Aqara
- DOMAIN-KEYWORD,aqara-camera-sg.,Home-Aqara
- RULE-SET,015-Home-Aqara-ip0,Home-Aqara
- RULE-SET,016-Drive-OneDrive-domain,Drive-OneDrive
- DOMAIN-KEYWORD,1drv,Drive-OneDrive
- DOMAIN-KEYWORD,onedrive,Drive-OneDrive
- DOMAIN-KEYWORD,skydrive,Drive-OneDrive
- RULE-SET,017-Drive-Dropbox-domain,Drive-Dropbox
- RULE-SET,018-Drive-MEGA-domain,Drive-MEGA
- RULE-SET,018-Drive-MEGA-ip0,Drive-MEGA
- RULE-SET,019-Drive-Imgur-domain,Drive-Imgur
- RULE-SET,020-Drive-InternetArchive-domain,Drive-InternetArchive
- RULE-SET,020-Drive-InternetArchive-ip0,Drive-InternetArchive
- RULE-SET,021-P2P-PT-domain,P2P-PT
- DOMAIN-KEYWORD,announce,P2P-PT
- DOMAIN-KEYWORD,chdbits,P2P-PT
- DOMAIN-KEYWORD,m-team,P2P-PT
- DOMAIN-KEYWORD,torrent,P2P-PT
- RULE-SET,021-P2P-PT-ip0,P2P-PT
- RULE-SET,022-P2P-eMule-ip0,P2P-eMule
- RULE-SET,023-Finance-PayPal-domain,Finance-PayPal
- DOMAIN-KEYWORD,paypal,Finance-PayPal
- RULE-SET,024-Finance-Wise-domain,Finance-Wise
- DOMAIN-KEYWORD,transferwise,Finance-Wise
